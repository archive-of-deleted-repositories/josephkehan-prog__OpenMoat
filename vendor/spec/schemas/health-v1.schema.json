{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmoat.dev/schema/health-v1.schema.json",
  "title": "OpenMoat Health v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "servers"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["ok", "degraded", "failed"]},
    "pools": {"type": "integer", "minimum": 0},
    "poolLimit": {"type": "integer", "minimum": 1},
    "queuedCalls": {"type": "integer", "minimum": 0},
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "failures", "children"],
        "properties": {
          "status": {"enum": ["cold", "starting", "ready", "open", "failed", "stopped"]},
          "latencyMs": {"type": "number", "minimum": 0},
          "failures": {"type": "integer", "minimum": 0},
          "children": {"type": "integer", "minimum": 0},
          "lastErrorCode": {"type": "string"}
        }
      }
    }
  }
}
