{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmoat.dev/schema/plan-v1.schema.json",
  "title": "OpenMoat Reconciliation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "operations"],
  "properties": {
    "version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {"enum": ["create", "update", "remove", "unchanged"]},
          "path": {"type": "string", "minLength": 1},
          "beforeHash": {"type": ["string", "null"]},
          "afterHash": {"type": ["string", "null"]},
          "content": {"type": "string"}
        }
      }
    }
  }
}
