{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmoat.dev/schema/gateway-v1.schema.json",
  "title": "OpenMoat Gateway v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["callers", "servers"],
  "properties": {
    "callers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/caller"}
    },
    "zones": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/zone"},
      "default": {}
    },
    "limits": {"$ref": "#/$defs/gatewayLimits"},
    "servers": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/server"}
    }
  },
  "$defs": {
    "patternList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {"$ref": "#/$defs/patternList"},
        "deny": {"$ref": "#/$defs/patternList"},
        "zone": {"type": "string", "minLength": 1, "default": "default"}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowMixedRisk": {"type": "boolean", "default": false}
      }
    },
    "gatewayLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxPools": {"type": "integer", "minimum": 1, "default": 32},
        "maxPoolsPerServer": {"type": "integer", "minimum": 1, "default": 8},
        "idleTimeoutMs": {"type": "integer", "minimum": 1, "default": 300000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failureThreshold": {"type": "integer", "minimum": 1, "default": 3},
        "resetAfterMs": {"type": "integer", "minimum": 1, "default": 60000},
        "maxConcurrentCalls": {"type": "integer", "minimum": 1, "default": 8}
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}, "default": []},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"},
          "default": {}
        },
        "inheritEnv": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "uniqueItems": true,
          "default": []
        },
        "cwd": {"type": "string", "minLength": 1},
        "cwdRoots": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "public-read",
              "sensitive-read",
              "filesystem-write",
              "network-egress",
              "process-control",
              "secrets",
              "memory-write"
            ]
          },
          "uniqueItems": true,
          "default": []
        },
        "zone": {"type": "string", "minLength": 1, "default": "default"},
        "trust": {
          "type": "string",
          "enum": ["trusted", "quarantined", "disabled"],
          "default": "quarantined"
        },
        "startupTimeoutMs": {"type": "integer", "minimum": 1, "default": 10000},
        "callTimeoutMs": {"type": "integer", "minimum": 1, "default": 30000},
        "limits": {"$ref": "#/$defs/limits"}
      }
    }
  }
}
