{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmoat.dev/schema/error-v1.schema.json",
  "title": "OpenMoat Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "INVALID_CONFIG", "UNRESOLVED_ENV", "UNAUTHORIZED", "QUARANTINED",
        "SERVER_NOT_FOUND", "TOOL_NOT_FOUND", "PROCESS_FAILED", "TIMEOUT",
        "CIRCUIT_OPEN", "PROTOCOL_ERROR", "INTERNAL"
      ]
    },
    "message": {"type": "string", "minLength": 1},
    "server": {"type": "string"},
    "tool": {"type": "string"},
    "retryable": {"type": "boolean", "default": false},
    "details": {"type": "object"}
  }
}
