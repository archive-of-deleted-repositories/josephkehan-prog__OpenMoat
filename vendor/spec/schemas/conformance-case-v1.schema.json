{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmoat.dev/schema/conformance-case-v1.schema.json",
  "title": "OpenMoat Conformance Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "driver", "operation", "input", "expected"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "driver": {"enum": ["cli", "contract", "mcp"]},
    "operation": {
      "enum": [
        "validate", "resolve_path", "resolve_env", "authorize",
        "caller_binding", "cwd_root_escape", "environment_isolation",
        "metadata_poisoning", "pool_limit", "process_failure",
        "secret_redaction", "shutdown", "timeout", "doctor"
      ]
    },
    "input": {"type": "object"},
    "expected": {"type": "object"},
    "redact": {"type": "array", "items": {"type": "string"}}
  }
}
