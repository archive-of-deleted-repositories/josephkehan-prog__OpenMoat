apiVersion: openmoat.dev/v1
kind: Moatfile
paths:
  state: ./state
  secrets: ./secrets.env
gateway:
  callers:
    "*":
      deny:
        - "*"
  zones: {}
  limits:
    maxPools: 32
    maxPoolsPerServer: 8
    idleTimeoutMs: 300000
  archives:
    maxBlobBytes: 1048576
    maxCallerBytes: 16777216
    maxCallerEntries: 64
    ttlDays: 14
  servers: {}
prewarm: []
