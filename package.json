{
  "name": "openmoat",
  "version": "1.0.0",
  "description": "Local security gateway for MCP with deny-by-default policy and stateless protocol support.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "moat": "dist/cli.js"
  },
  "files": [
    "dist/",
    "examples/Moatfile",
    "schemas/",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs/threat-model.md",
    "docs/release-checklist.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsc && node --test test/*.test.mjs",
    "test:coverage": "c8 --all --include=dist/admin.js --include=dist/archive.js --include=dist/catalog.js --include=dist/config.js --include=dist/db.js --include=dist/doctor.js --include=dist/health.js --include=dist/init.js --include=dist/policy.js --include=dist/process-tree.js --include=dist/registry.js --include=dist/runtime-security.js --include=dist/server.js --include=dist/tool-catalog.js --include=dist/tool-policy.js --include=dist/tool-surface.js --reporter=text --check-coverage --lines=80 --functions=80 --branches=80 node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "serve": "node dist/cli.js serve",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "yaml": "^2.6.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "c8": "11.0.0",
    "typescript": "^5.7.2"
  }
}
