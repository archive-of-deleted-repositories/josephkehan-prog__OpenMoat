{
  "name": "openmoat",
  "version": "0.4.0",
  "description": "Local-first MCP gateway and shared agent configuration reconciler.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "moat": "dist/cli.js"
  },
  "files": [
    "dist/",
    "examples/",
    "vendor/spec/cases/",
    "vendor/spec/conformance/*.py",
    "vendor/spec/fixtures/",
    "vendor/spec/schemas/",
    "LICENSE",
    "README.md",
    "ARCHITECTURE.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.mjs",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:gateway",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include=dist/config.js --test-coverage-include=dist/context-store.js --test-coverage-include=dist/reconcile.js --test-coverage-include=dist/integrations.js --test-coverage-include=dist/policy.js --test-coverage-include=dist/registry.js --test-coverage-include=dist/runtime-security.js --test-coverage-include=dist/tool-catalog.js --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 test/*.test.mjs",
    "test:coverage:gateway": "c8 --all --include=dist/archive.js --include=dist/config.js --include=dist/context-store.js --include=dist/db.js --include=dist/gateway-runtime.js --include=dist/gateway.js --include=dist/init.js --include=dist/instincts.js --include=dist/integrations.js --include=dist/policy.js --include=dist/process-tree.js --include=dist/reconcile.js --include=dist/registry.js --include=dist/runtime-security.js --include=dist/server.js --include=dist/tool-catalog.js --include=dist/tool-surface.js --reporter=text --check-coverage --lines=80 --functions=80 --branches=80 node scripts/coverage-suite.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "sync": "node dist/cli.js sync",
    "serve": "node dist/cli.js serve",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "c8": "11.0.0",
    "typescript": "^5.7.2"
  }
}
