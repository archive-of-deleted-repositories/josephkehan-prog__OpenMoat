{
  "registry": "./registry/mcp-servers.json",
  "secretsEnv": "./secrets.env",
  "stateDir": "./state",
  "skillsDir": "./skills",
  "pluginsDir": "./plugins",
  "federation": {
    "includeLocal": true,
    "conflictPolicy": "error",
    "sources": []
  },
  "profileFiles": ["./profile/AGENTS.md"],
  "memoryImport": "./AGENTS.md",
  "contextDir": "./context",
  "rag": {
    "db": "./state/rag.db",
    "include": ["./profile", "./context"],
    "embeddings": {"provider": "none", "model": ""}
  },
  "targets": {
    "codex": {"enabled": false, "config": "~/.codex/config.toml", "memoryFile": "~/.codex/AGENTS.md"},
    "claude-code": {"enabled": false, "config": "~/.claude.json", "memoryFile": "~/.claude/CLAUDE.md"},
    "claude-desktop": {"enabled": false, "config": "~/Library/Application Support/Claude/claude_desktop_config.json"},
    "hermes": {"enabled": false, "config": "~/.hermes/config.yaml"},
    "opencode": {"enabled": false, "config": "~/.config/opencode/opencode.jsonc", "memoryFile": "~/.config/opencode/AGENTS.md"},
    "cursor": {"enabled": false, "config": "~/.cursor/mcp.json"},
    "pi": {"enabled": false, "config": "~/.pi/agent/mcp.json"},
    "zed": {"enabled": false, "config": "~/.config/zed/settings.json"},
    "continue": {"enabled": false, "config": "~/.continue/config.yaml"},
    "warp": {"enabled": false, "config": "~/.warp/.mcp.json"},
    "factory": {"enabled": false, "config": "~/.factory/mcp.json"},
    "vscode": {"enabled": false, "config": "~/Library/Application Support/Code/User/mcp.json"}
  },
  "gatewayPolicy": {"default": "deny", "agents": {}},
  "prewarm": []
}
